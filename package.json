{
  "name": "web-bapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --karma-config karma.conf.js",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list,html",
    "e2e:smoke:prod": "playwright test e2e/smoke.prod.spec.ts --project=chromium --reporter=list",
    "e2e:smoke:local": "BASE_URL=http://localhost:4200 playwright test e2e/smoke.prod.spec.ts --project=chromium --reporter=list",
    "e2e:ci:chromium": "playwright test --project=chromium --reporter=list,html",
    "e2e:local:chromium": "BASE_URL=http://localhost:4200 playwright test --project=chromium --reporter=list",
    "e2e:local:desktop": "BASE_URL=http://localhost:4200 playwright test --project=chromium --project=firefox --project=webkit --reporter=list --grep-invert @auth",
    "e2e:flows:auth": "BASE_URL=http://localhost:4200 playwright test e2e/authenticated-flows.spec.ts --project=chromium --reporter=list",
    "e2e:flows:auth:mutating": "E2E_ALLOW_MUTATIONS=true BASE_URL=http://localhost:4200 playwright test e2e/authenticated-flows.spec.ts --project=chromium --reporter=list",
    "qa:prepublish": "npm run build && npm run e2e:local:desktop",
    "qa:prepublish:fast": "npm run build && npm run e2e:smoke:local",
    "qa:validate:all": "npm run build && npm run e2e:local:desktop && npm run e2e:flows:auth",
    "stress:smoke": "k6 run stress/smoke.js",
    "stress:load": "k6 run stress/load.js",
    "stress:stress": "k6 run stress/stress.js",
    "stress:spike": "k6 run stress/spike.js"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.3.0",
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.14",
    "@types/leaflet.markercluster": "^1.5.6",
    "ionicons": "^7.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "autoprefixer": "^10.4.27",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.2"
  }
}
